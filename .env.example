# Every key `apps/api/src/platform/config/config.ts` reads, placeholder
# values only — F39 (secret-rules.spec.ts, M0-23) asserts this list equals
# the typed config module's key set exactly, in both directions. A config key
# with no documented example here is a key the next developer discovers from
# a stack trace.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/questionbank
PORT=3000
NODE_ENV=development
AUTH_SIGNING_KEY=replace-with-a-real-32-byte-random-value
# The audit anchor's HMAC key (M4-24, ADR-0020). Must differ from
# AUTH_SIGNING_KEY: one key compromised should not forge both sessions and
# history, and config refuses to boot if the two are equal.
AUDIT_ANCHOR_KEY=replace-with-a-different-32-byte-random-value
AUTH_ISSUER=questionbank
AUTH_TOKEN_TTL_SECONDS=3600
MEDIA_STORAGE_ROOT=./var/media
LOG_LEVEL=info
# ReviewPolicy's four thresholds (DEC-M4-1, DEC-M4-14, M4-26). Defaults shown.
REVIEW_WARN_AFTER_HOURS=48
REVIEW_ESCALATE_AFTER_HOURS=72
REVIEW_LEASE_HOURS=4
REVIEW_SAMPLE_RATE=0.05
# Optional. Which registry rows each judged pre-check runs under (M5-37): a JSON
# object mapping each of the six judged check ids to its model and prompt version
# ids. Versions are pinned data, so there is no default; left unset, generation is
# composed with every check declared blocked and nothing can be accepted. Set but
# invalid, the application refuses to start.
GENERATION_PRECHECK_CONFIG=
# Optional. The Ed25519 seed form packages are signed with (M6-26): 32 random bytes,
# base64 (for example `openssl rand -base64 32`). No default. Left unset, the package
# routes answer as unavailable and the rest of the application boots. Set but not a
# 32-byte base64 value, or equal to either key above, and it refuses to start.
FORM_PACKAGE_SIGNING_KEY=
# The longest one visit-to-leave interval may count towards an item's time on item (ASSESSMENT-ENGINE section 4):
# longer is taken as the app having been backgrounded. Pinned onto each attempt when it is created and told to the
# device, so a device and the server project one log with one value. Milliseconds; default shown.
TIME_ON_ITEM_INTERVAL_CAP_MS=120000
# Whether this process runs the background jobs: the outbox relay and the sweeps (open and close form windows, abandon and
# submit attempts, review ageing). On by default; every instance may run them, because they claim or are idempotent. Off for
# a process that should only serve requests.
BACKGROUND_JOBS_ENABLED=true
