{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questionbank.example/schemas/taxonomy.schema.json",
  "title": "Taxonomy import file",
  "description": "A whole syllabus as reviewable data. The loader validates the entire file before writing anything.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "examFamily", "academicYear", "subjects"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "examFamily": { "type": "string", "minLength": 1 },
    "academicYear": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/subject" }
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 120
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectDomain", "root"],
      "properties": {
        "subjectDomain": { "$ref": "#/$defs/slug" },
        "root": { "$ref": "#/$defs/concept" }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "displayName"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" },
        "displayName": { "type": "string", "minLength": 1 },
        "canonicalName": { "type": "string", "minLength": 1 },
        "examWeight": { "type": "number", "minimum": 0, "maximum": 1 },
        "estimatedTeachingHours": { "type": "number", "minimum": 0 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/concept" }
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/slug" },
        "to": { "$ref": "#/$defs/slug" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
